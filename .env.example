# Copy to .env and fill in. Never commit .env. Keys are handed person to person, never via git
# or chat logs. Everything runs without keys: the judge, distiller and retriever fall back to
# local stubs and say so on the dashboard (labelled simulated).

# --- Canon server (lane A, server/) ---
CANON_PORT=4100
# What the hook, extension, distiller and dashboard talk to.
CANON_URL=http://localhost:4100
# Fact store + cold archive, relative to the repo root. Gitignored. Open it in Obsidian.
CANON_DATA_DIR=data
# One token per AI client, `client=token,client=token`. Grants per client are in
# shared/src/types/grants.ts (demo defaults) or CANON_GRANTS_FILE. Dev values, not secrets.
CANON_CLIENT_TOKENS=claude-code=dev-claude-code,chatgpt=dev-chatgpt,teammate-cursor=dev-teammate-cursor,distiller=dev-distiller,dispatcher=dev-dispatcher,ingest=dev-ingest,wags=dev-wags,axe=dev-axe,ben=dev-ben,dollar-bill=dev-dollar-bill
# Optional JSON file of Grant[] that replaces the demo defaults.
CANON_GRANTS_FILE=

# --- Judge: Jev with Claude fallback (shared/src/judge/) ---
# jev | claude | fake. Empty = jev when JEV_API_KEY is set, else claude when ANTHROPIC_API_KEY
# is set, else fake (simulated).
JUDGE_PROVIDER=
# Jev (TypeSafe AI): your key from console.typesafe.ai/keys (TYPESAFE_API_KEY also works).
# JEV_API_URL defaults to https://api.typesafe.ai/v1/systemone; JEV_MODEL to jev-latest.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
ANTHROPIC_API_KEY=
# Anthropic API base URL override, shared by the judge, distiller and bench responder.
# Empty = https://api.anthropic.com. Tests point it at a local mock; leave empty otherwise.
ANTHROPIC_BASE_URL=

# --- Distiller (lane B, distiller/) ---
# droid | claude | heuristic. Empty = claude when ANTHROPIC_API_KEY is set, else heuristic
# (simulated). droid only when named here: FACTORY_API_KEY is the agent dispatcher's key (B2),
# so setting it does not switch the distiller.
DISTILLER=
FACTORY_API_KEY=
# The firm's IANA time zone. The Claude fact writer shows message times in it, so a fact's
# happened date is the firm's day. Empty = America/Los_Angeles; a bad zone fails at startup.
FIRM_TZ=
# Optional Factory model ID; empty uses the account default.
FACTORY_MODEL=
# Token the distiller worker uses to POST decided facts. Must match the distiller=… pair above.
CANON_TOKEN_DISTILLER=dev-distiller
# 1 = distill on every capture (debounced), not only when the session has ended.
DISTILL_LIVE=

# --- Agent dispatch (lane B, distiller/src/dispatch/) ---
# Token the dispatcher worker uses to read an agent's scope rule and scope facts, ask for its
# handoff, publish agent events and save its outputs as its creator's memory. The server must
# know it as a dispatcher=… pair in CANON_CLIENT_TOKENS above (lane A adds it with the scope routes;
# until then, add `,dispatcher=dev-dispatcher` to your own .env).
CANON_TOKEN_DISPATCHER=dev-dispatcher
# droid | claude | fake. Empty = droid when the droid binary is on PATH and FACTORY_API_KEY is
# set AND a supported OS sandbox is available, else claude when ANTHROPIC_API_KEY is set,
# else fake (simulated). The Docker preview explicitly uses claude; Linux Droid dispatch needs a sandbox.
DISPATCH_RUNTIME=
# Most runtime invocations per agent folder (a plan step, then work steps; a narrowed scope
# restarts the run in a fresh folder). Empty = 4.
DISPATCH_MAX_STEPS=
# Absolute folder for live agent sandboxes. Must sit outside the repo and the data dir (checked).
# Empty = <OS temp dir>/canon-agents. Finished runs are kept, locked, in <data dir>/agents.
DISPATCH_SANDBOX_DIR=
# auto | on | off. auto = on macOS, run droid under sandbox-exec with the repo, the data dir and
# other runs' folders denied (skipped where sandbox-exec cannot nest); on = require it.
DISPATCH_OS_SANDBOX=

# --- Retrieval (lane A, server/src/retrieval/) ---
# Moss authenticates a local session and embeds/searches locally. Empty = keyword stub.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- Capture clients (lane B, hooks/ and extension/) ---
# Token the Claude Code hook sends. Must match a client=token pair above.
CANON_TOKEN_CLAUDE_CODE=dev-claude-code
# Use one person-bound token for BOTH Claude Code capture and context/MCP reads.
# Choose your own identity (wags, axe, ben, dollar-bill); never an internal worker token.
# The server binds authorship to this token, regardless of the capture source label.
CANON_PERSON_TOKEN=
# Legacy operator capture only; not an authority to impersonate a person.
CANON_PRINCIPAL=
# Optional token budget for that slice. Empty = the server default.
CANON_CONTEXT_BUDGET=
# Token the ingest CLI (hooks/ingest/: memos, team chat, transcripts, email) sends. The server
# accepts it as the ingest=dev-ingest pair in CANON_CLIENT_TOKENS above (an older .env needs
# ",ingest=dev-ingest" appended to that line).
CANON_TOKEN_INGEST=dev-ingest
# 1 = the hook writes one short line to stderr per run. Empty = silent.
CANON_DEBUG=
# 0 = the committed project hook (.claude/settings.json) skips capture. Set it in your shell
# environment, not here: the hook reads it from the env Claude Code runs in.
CANON_CAPTURE=
# Where Claude Code capture, context and installer tooling look for `.env`. Empty searches the hook's
# checkout first, then the primary checkout that owns the Git worktree, so one person token works in
# every worktree without copying credentials.
CANON_REPO_ROOT=

# --- Web dashboard (lane B, web/) ---
WEB_PORT=4200

# --- Benchmark (lane A runs, bench/) ---
# USD per 1M tokens for cost_usd in bench/results/. Both must be numbers; either unset = cost
# stays null (never guessed). Take them from the model's price page, never from memory.
BENCH_PRICE_PER_MTOK_IN=
BENCH_PRICE_PER_MTOK_OUT=
