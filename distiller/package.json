{
  "name": "@canon/distiller",
  "version": "0.1.0",
  "private": true,
  "description": "Droid distiller worker: captured session in, facts out, with Jev save-time decisions. Lane B.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
