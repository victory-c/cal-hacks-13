{
  "name": "@canon/web",
  "version": "0.1.0",
  "private": true,
  "description": "Live dashboard (sessions, facts, token/latency/cost counter) and resume viewer. Static, bundled with esbuild. Lane B.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "start": "node --import tsx scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@canon/shared": "*"
  }
}
