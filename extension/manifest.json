{
  "manifest_version": 3,
  "name": "Bullwark Capture",
  "version": "0.1.0",
  "description": "Streams your ChatGPT web sessions into Bullwark as you chat. Turn text only.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {}
}
